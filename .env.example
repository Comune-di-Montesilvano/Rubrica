# -----------------------------------------------------------------------------
# LdavSync - Example Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and adapt values for your environment.
#
# Notes:
# - compose.yml uses SERVER_PORT for host/container mapping.
# - For production, always set a strong random SESSION_SECRET.
# - For Active Directory, sync search usually requires LDAP_BIND_DN/PASSWORD.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Bind address inside container/process (usually 0.0.0.0).
SERVER_HOST=0.0.0.0

# HTTP port exposed by the app. Keep in sync with compose port mapping.
SERVER_PORT=8080


# -----------------------------------------------------------------------------
# LDAP / Active Directory Configuration
# -----------------------------------------------------------------------------
# LDAP endpoint:
# - ldap://host:389   (plain LDAP, optionally with StartTLS)
# - ldaps://host:636  (TLS native)
LDAP_HOST=ldap://ldap.example.com:389

# Base DN for searches.
# OpenLDAP example: dc=example,dc=com
# AD example:       DC=intranet,DC=example,DC=com
LDAP_BASE_DN=dc=example,dc=com

# User bind template used for login authentication:
# - Supports {username} style, e.g. uid={username},ou=users,dc=example,dc=com
# - Supports %s style, e.g. %s@intranet.example.com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com

# Service account used by sync/search operations.
# IMPORTANT: in many AD environments anonymous search is disabled,
# so these must be set for contact sync to work.
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=change-me

# StartTLS upgrade (applies when LDAP_HOST starts with ldap://).
# Set false if your server does not support StartTLS.
LDAP_START_TLS=true

# Skip certificate verification for TLS/StartTLS.
# Use true only for internal CA or self-signed certificates.
LDAP_TLS_SKIP_VERIFY=false

# Optional admin group value (currently informational in app logic).
LDAP_ADMIN_GROUP=cn=admins,ou=groups,dc=example,dc=com

# LDAP search filter used by sync.
# Default supports both OpenLDAP inetOrgPerson and AD user objects.
LDAP_SEARCH_FILTER=(|(objectClass=inetOrgPerson)(&(objectCategory=person)(objectClass=user)))

# If true, include only active users (AD disabled users are excluded).
# Recommended: true in production directories.
LDAP_ONLY_ACTIVE=true

# Optional semicolon-separated group filter for sync.
# If empty, all matched users are synchronized.
# You can use:
# - NETBIOS style: COMUNE-MS\INTERNI;COMUNE-MS\ESTERNI
# - CN style:      INTERNI;ESTERNI
# - Full DN style: CN=INTERNI,OU=Groups,DC=example,DC=com
LDAP_ALLOWED_GROUPS=


# -----------------------------------------------------------------------------
# Application Admins
# -----------------------------------------------------------------------------
# Semicolon-separated usernames allowed as app admins.
# Example: ADMIN_USERS=admin;mario.rossi;helpdesk
ADMIN_USERS=admin;mario.rossi;admin2


# -----------------------------------------------------------------------------
# Sync Configuration
# -----------------------------------------------------------------------------
# LDAP sync frequency in hours.
SYNC_INTERVAL_HOURS=1


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# In containerized deployments keep this under /data for persistence.
DATABASE_PATH=/data/ldavsync.db


# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Required for secure session cookie signing.
# Generate a long random value before production deployment.
SESSION_SECRET=change-me-to-a-random-secret-string-in-production


# -----------------------------------------------------------------------------
# Phone Number Formatting
# -----------------------------------------------------------------------------
# Template used to build the primary number from LDAP extension.
# Use {ext} placeholder to insert the extension number.
# Examples:
#   0854321{ext}      -> 08543211234 (if ext=1234)
#   +39 085 4321 {ext} -> +39 085 4321 1234
#
# NOTE: this is only the initial seed value, imported into the database
# once on first startup. From then on the source of truth is the admin
# panel (Configurazione) — editing this after the first run has no effect.
PRIMARY_NUMBER_PREFIX_TEMPLATE=0854321{ext}
